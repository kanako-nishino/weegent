{
  "name": "weegent",
  "private": true,
  "scripts": {
    "sass:build": "sass sass/style.scss:css/style.css --style=expanded --source-map",
    "sass:build:min": "sass sass/style.scss:css/style.min.css --style=compressed --source-map",
    "sass:watch": "sass sass/style.scss:css/style.css --watch --style=expanded --source-map",
    "serve": "browser-sync start --server --files \"css/*.css, *.html, js/*.js\"",
    "build": "npm-run-all sass:build sass:build:min",
    "dev": "npm-run-all -p sass:watch serve"
  },
  "devDependencies": {
    "browser-sync": "^3.0.3",
    "npm-run-all": "^4.1.5",
    "sass": "^1.79.4"
  }
}
